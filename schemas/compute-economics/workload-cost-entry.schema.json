{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/avaargsh/compute-control-panel/main/schemas/compute-economics/workload-cost-entry.schema.json",
  "title": "Compute Economics WorkloadCostEntry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "costEntryId",
    "entryType",
    "tenantId",
    "projectId",
    "workloadId",
    "allocationId",
    "providerId",
    "poolId",
    "profileId",
    "usageIntervalId",
    "pricedWindow",
    "pricedQuantity",
    "unit",
    "rateCardId",
    "rateCardVersion",
    "rateAmount",
    "currency",
    "amount",
    "calculationVersion",
    "roundingMode",
    "calculationStatus",
    "recordedAt",
    "sourceCoverage",
    "currencyMinorUnit",
    "calculationInputDigest",
    "currencyMetadataVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "compute.economics.workload-cost-entry.v1"
    },
    "costEntryId": {
      "type": "string",
      "minLength": 1
    },
    "entryType": {
      "enum": [
        "CHARGE",
        "REVERSAL"
      ]
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workloadId": {
      "type": "string",
      "minLength": 1
    },
    "allocationId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "poolId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "usageIntervalId": {
      "type": "string",
      "minLength": 1
    },
    "pricedWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "pricedQuantity": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "description": "Strictly positive base-10 decimal string. Never use binary floating point for accounting values."
    },
    "unit": {
      "const": "GPU_HOUR"
    },
    "rateCardId": {
      "type": "string",
      "minLength": 1
    },
    "rateCardVersion": {
      "type": "integer",
      "minimum": 1
    },
    "rateAmount": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "description": "Strictly positive base-10 decimal string. Never use binary floating point for accounting values."
    },
    "currency": {
      "type": "string",
      "enum": [
        "AED",
        "AUD",
        "BHD",
        "BRL",
        "CAD",
        "CHF",
        "CLF",
        "CLP",
        "CNY",
        "CZK",
        "DKK",
        "EUR",
        "GBP",
        "HKD",
        "INR",
        "IQD",
        "ISK",
        "JOD",
        "JPY",
        "KRW",
        "KWD",
        "LYD",
        "MXN",
        "MYR",
        "NOK",
        "NZD",
        "OMR",
        "PHP",
        "PLN",
        "SAR",
        "SEK",
        "SGD",
        "THB",
        "TND",
        "TWD",
        "USD",
        "VND",
        "XAF",
        "XOF",
        "XPF",
        "ZAR"
      ],
      "description": "Must be present in the pinned Compute Economics currency metadata subset."
    },
    "amount": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "description": "Strictly positive base-10 decimal string. Never use binary floating point for accounting values."
    },
    "calculationVersion": {
      "type": "string",
      "minLength": 1
    },
    "calculationInputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 digest over canonical usage interval content, priced segment, rate-card identity/version, calculation version, currency metadata snapshot version and currency precision."
    },
    "roundingMode": {
      "const": "CURRENCY_MINOR_UNIT_HALF_UP"
    },
    "calculationStatus": {
      "const": "FINAL",
      "description": "Only complete, fully covered postings are persisted as WorkloadCostEntry records. Incomplete calculations return an outcome without posting a cost entry."
    },
    "reversesEntryId": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCoverage": {
      "const": 1
    },
    "currencyMinorUnit": {
      "type": "integer",
      "enum": [
        0,
        2,
        3,
        4
      ],
      "description": "Must exactly match the currency's minor unit in currencyMetadataVersion."
    },
    "currencyMetadataVersion": {
      "const": "six-list-one-2026-09-17-subset-v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entryType": {
            "const": "REVERSAL"
          }
        },
        "required": [
          "entryType"
        ]
      },
      "then": {
        "required": [
          "reversesEntryId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entryType": {
            "const": "CHARGE"
          }
        },
        "required": [
          "entryType"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reversesEntryId"
          ]
        }
      }
    }
  ],
  "description": "Append-only direct cost posting for one usage interval segment and one effective-dated rate. Reversals are new entries; amounts are unsigned magnitudes and entryType determines accounting direction.",
  "oneOf": [
    {
      "properties": {
        "currency": {
          "const": "AED"
        },
        "currencyMinorUnit": {
          "const": 2
