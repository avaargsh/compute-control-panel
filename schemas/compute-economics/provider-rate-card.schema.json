{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/avaargsh/compute-control-panel/main/schemas/compute-economics/provider-rate-card.schema.json",
  "title": "Compute Economics ProviderRateCard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rateCardId",
    "version",
    "providerId",
    "profileId",
    "rateBasis",
    "unit",
    "rateAmount",
    "currency",
    "effectiveFrom",
    "sourceRef",
    "currencyMinorUnit",
    "currencyMetadataVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "compute.economics.provider-rate-card.v1"
    },
    "rateCardId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "poolId": {
      "type": [
        "string",
        "null"
      ]
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "rateBasis": {
      "const": "ALLOCATED_GPU_HOUR"
    },
    "unit": {
      "const": "GPU_HOUR"
    },
    "rateAmount": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "description": "Strictly positive base-10 decimal string. Never use binary floating point for accounting values."
    },
    "currency": {
      "type": "string",
      "enum": [
        "AED",
        "AUD",
        "BHD",
        "BRL",
        "CAD",
        "CHF",
        "CLF",
        "CLP",
        "CNY",
        "CZK",
        "DKK",
        "EUR",
        "GBP",
        "HKD",
        "INR",
        "IQD",
        "ISK",
        "JOD",
        "JPY",
        "KRW",
        "KWD",
        "LYD",
        "MXN",
        "MYR",
        "NOK",
        "NZD",
        "OMR",
        "PHP",
        "PLN",
        "SAR",
        "SEK",
        "SGD",
        "THB",
        "TND",
        "TWD",
        "USD",
        "VND",
        "XAF",
        "XOF",
        "XPF",
        "ZAR"
      ],
      "description": "ISO 4217 currency code in the explicit Compute Economics v1 supported subset. Other ISO codes require a reviewed metadata snapshot update."
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "currencyMinorUnit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Must exactly match the minor-unit value in currencyMetadataVersion; mismatches are rejected."
    },
    "currencyMetadataVersion": {
      "const": "six-list-one-2026-09-17-subset-v1",
      "description": "Pinned application currency metadata snapshot. Persist this exact version for reproducible cost calculations."
    }
  },
  "description": "Versioned procurement rate for the initial direct Workload cost slice. Rate windows are start-inclusive and end-exclusive.",
